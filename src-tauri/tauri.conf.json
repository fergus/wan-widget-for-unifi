{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WAN Widget for UniFi",
  "version": "0.1.0",
  "identifier": "io.github.fergus.unifi-widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WAN Widget for UniFi",
        "width": 360,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "WAN Widget for UniFi Settings",
        "url": "settings.html",
        "width": 460,
        "height": 640,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
