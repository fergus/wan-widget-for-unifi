{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WAN Widget for UniFi",
  "identifier": "io.github.fergus.unifi-widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WAN Widget for UniFi",
        "width": 360,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "WAN Widget for UniFi Settings",
        "url": "settings.html",
        "width": 460,
        "height": 640,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "fergus",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MTExMkE1ODI5MDM0NkEKUldScU5KQ0NwUklSQ05JTjFCNGxvdFhJbVNnVmdMMVNYY2pPZVA5dlRwNUEzRlE5bmh6czJBNmQK",
      "endpoints": [
        "https://github.com/fergus/wan-widget-for-unifi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
